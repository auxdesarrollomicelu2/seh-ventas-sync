# Base de datos (solo lectura)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Autenticación API
API_KEY=tu_api_key_secreta

# GHL API v2
GHL_TOKEN=tu_ghl_token
GHL_LOCATION_ID=tu_location_id
GHL_PIPELINE_ID=tu_pipeline_id
GHL_STAGE_VENTA_REALIZADA_ID=tu_stage_id

# Sincronización
SYNC_DESDE=2024-01-01
SYNC_INTERVALO_MIN=10
DRY_RUN=true

# Logging
LOG_LEVEL=INFO

# Campos opcionales (si no existen, dejar vacío)
NOMBRE_TABLA=
NOMBRE_COLUMNA=
